<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in tokens never leave the device in cloud backups or device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="zomi_portal_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zomi_portal_session.xml" />
    </device-transfer>
</data-extraction-rules>
